# Rendered at container start via envsubst (PORT, BACKEND_URL).
# Static UI:  /usr/share/nginx/html/inventory/  (CRA homepage=/inventory)
# BACKEND_URL: Railway private URL, e.g. http://api.railway.internal:8080
#              or public API, e.g. https://api.katariastoneworld.com

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  client_max_body_size 25m;

  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
  }

  server {
    listen ${PORT};
    server_name _;

    # Gateway health (Railway healthcheck) — does not hit backend
    location = /health {
      access_log off;
      default_type text/plain;
      return 200 'ok';
    }

    # Root → inventory SPA (files live under /inventory/, not at web root)
    location = / {
      return 302 /inventory/;
    }

    location = /inventory {
      return 301 /inventory/;
    }

    # React inventory SPA (CRA homepage /inventory)
    # URI /inventory/foo → file /usr/share/nginx/html/inventory/foo
    location /inventory/ {
      root /usr/share/nginx/html;
      index index.html;
      try_files $uri $uri/ /inventory/index.html;
    }

    # Spring Boot API — requires BACKEND_URL at runtime (Railway variable)
    location /api/ {
      proxy_pass ${BACKEND_URL};
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_connect_timeout 60s;
      proxy_send_timeout 120s;
      proxy_read_timeout 120s;
    }

    # Actuator health through same host (optional; needs BACKEND_URL)
    location /actuator/ {
      proxy_pass ${BACKEND_URL};
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_connect_timeout 60s;
      proxy_send_timeout 120s;
      proxy_read_timeout 120s;
    }

    location /swagger-ui.html {
      proxy_pass ${BACKEND_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /api-docs {
      proxy_pass ${BACKEND_URL};
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
  }
}

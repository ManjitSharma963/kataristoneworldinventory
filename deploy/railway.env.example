# Gateway service — Railway Variables
#
# BUILD (railway.toml [build.args] or Railway build variables):
REACT_APP_API_URL=https://www.katariastoneworld.com
#
# RUNTIME (required — gateway service Variables):
# Use private networking if API service is named "api":
BACKEND_URL=http://api.railway.internal:8080
#
# Or public API host if private networking is not linked:
# BACKEND_URL=https://api.katariastoneworld.com
